{
  "name": "cliprename-desktop",
  "version": "0.1.12",
  "description": "ClipRename Desktop — point it at your editing folder, AI-sort and rename media, drag-and-drop ready for your NLE.",
  "author": "ClipRename",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://cliprename.com",
  "bugs": {
