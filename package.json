  },
  "repository": "github:trysky1/Cliprename-desktop-public",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --publish never",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "build:mac:arm64": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "build:mac:x64": "electron-vite build && electron-builder --mac --x64 --publish never",
    "build:dir": "electron-vite build && electron-builder --dir",
    "typecheck": "tsc -b --noEmit",
    "preview": "electron-vite preview",
    "start": "electron-vite preview"
  },
  "overrides": {
    "tar": "^7.5.19",
    "esbuild": "^0.25.10"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^7.3.6"
  }
}
