{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsc -b --noEmit",
            "timeout": 120,
            "statusMessage": "Type-checking (tsc)…"
          }
        ]
      }
    ]
  }
}
